VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox PUBLIC token (starts with "pk.") for rendering the map on the Route
# Engine page (src/components/RouteMap.jsx, via the mapbox-gl library). This
# is the one deliberate exception to "never put a provider key in a VITE_
# var" -- Mapbox explicitly designs public tokens for browser exposure. In
# your Mapbox account, restrict this token to your app's domain(s) under
# Tokens -> URL restrictions. It CANNOT geocode, compute routes, or do
# anything privileged -- that all happens server-side with a separate
# SECRET token (MAPBOX_SECRET_TOKEN, set via `supabase secrets set`, never
# put here or anywhere in src/). Without this var, the map shows a graceful
# "not configured" placeholder instead of crashing.
VITE_MAPBOX_PUBLIC_TOKEN=

# Dev-only auth bootstrap (see src/lib/devAuth.js). Never used in production —
# gated behind import.meta.env.DEV. Set these to the dev user created in
# Supabase Studio (Authentication -> Add user) and seeded into workspace_staff
# by supabase/migrations/20260724110000_seed_dev_workspace_membership.sql.
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=
